  </head>
  <body>
    <div class="container">
      <h1><%= title %> & TypeScript</h1>
      <p class="subtitle">Welcome to your modern Express application skeleton (rendered with EJS)</p>
      <div class="status-card">
        <span class="status-dot"></span>
        <span>Server is running successfully</span>
      </div>
      <div class="actions">
        <a href="/users" class="btn">Test Users Route</a>
      </div>
    </div>
  </body>
</html>
