#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

VERSION="1.0.0"

# Default values
VIEW_ENGINE="none"
CSS_ENGINE="css"
GIT_INIT=false
FORCE=false
PACKAGE_MANAGER="npm"
APP_DIR=""

show_help() {
  cat << EOF
Usage: express-ts [options] [dir]

Options:
  -h, --help          output usage information
      --version       output the version number
  -e, --ejs           add ejs engine support
      --pug           add pug engine support
      --hbs           add handlebars engine support
      --no-view       use static HTML instead of view engine (default)
  -c, --css <engine>  add stylesheet engine support (css, sass, less) (default: css)
  -g, --git           add .gitignore and initialize git repository
  -f, --force         force on non-empty directory
  -p, --pm <manager>  package manager: npm, yarn, pnpm, bun (default: npm)
  
  Builded by: Veton Milaimi
EOF
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    --version)
      echo "$VERSION"
      exit 0
      ;;
    -e|--ejs)
      VIEW_ENGINE="ejs"
      shift
      ;;
    --pug)
      VIEW_ENGINE="pug"
      shift
      ;;
    --hbs)
      VIEW_ENGINE="hbs"
      shift
      ;;
    --no-view)
      VIEW_ENGINE="none"
      shift
      ;;
    -c|--css)
      if [[ -z "$2" || "$2" =~ ^- ]]; then
        echo "Error: --css requires an argument (css, sass, less)" >&2
        exit 1
      fi
      CSS_ENGINE="$2"
      shift 2
      ;;
    -g|--git)
      GIT_INIT=true
      shift
      ;;
    -f|--force)
      FORCE=true
      shift
      ;;
    -p|--pm)
      if [[ -z "$2" || "$2" =~ ^- ]]; then
        echo "Error: --pm requires an argument (npm, yarn, pnpm, bun)" >&2
        exit 1
      fi
      PACKAGE_MANAGER="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1" >&2
      show_help
      exit 1
      ;;
    *)
      if [[ -n "$APP_DIR" ]]; then
        echo "Error: Multiple directories specified: $APP_DIR and $1" >&2
        exit 1
      fi
      APP_DIR="$1"
      shift
      ;;
  esac
done

# Validate CSS engine
if [[ "$CSS_ENGINE" != "css" && "$CSS_ENGINE" != "sass" && "$CSS_ENGINE" != "less" ]]; then
  echo "Error: Invalid CSS engine: $CSS_ENGINE. Choose from: css, sass, less" >&2
  exit 1
fi

# Validate Package Manager
if [[ "$PACKAGE_MANAGER" != "npm" && "$PACKAGE_MANAGER" != "yarn" && "$PACKAGE_MANAGER" != "pnpm" && "$PACKAGE_MANAGER" != "bun" ]]; then
  echo "Error: Invalid package manager: $PACKAGE_MANAGER. Choose from: npm, yarn, pnpm, bun" >&2
  exit 1
fi

# Set default directory
if [[ -z "$APP_DIR" ]]; then
  APP_DIR="."
fi

# Resolve absolute path for directory
ABS_APP_DIR=$(mkdir -p "$APP_DIR" && cd "$APP_DIR" && pwd)

# Check if non-empty and not force
if [ "$(ls -A "$ABS_APP_DIR" 2>/dev/null)" ] && [ "$FORCE" = false ]; then
  echo "Error: destination directory is not empty. Use -f or --force to override." >&2
  exit 1
fi

# Resolve app name
APP_NAME=$(basename "$ABS_APP_DIR")
if [[ "$APP_NAME" == "/" || -z "$APP_NAME" ]]; then
  APP_NAME="express-ts-app"
fi

echo "Creating a new Express TypeScript project in $ABS_APP_DIR..."

# Create directory structure
mkdir -p "$ABS_APP_DIR/src/bin"
mkdir -p "$ABS_APP_DIR/src/routes"
mkdir -p "$ABS_APP_DIR/src/controllers"
mkdir -p "$ABS_APP_DIR/src/public/images"
mkdir -p "$ABS_APP_DIR/src/public/javascripts"
mkdir -p "$ABS_APP_DIR/src/public/stylesheets"
if [[ "$VIEW_ENGINE" != "none" ]]; then
  mkdir -p "$ABS_APP_DIR/src/views"
fi

# ----------------- package.json -----------------
DEPS='    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.5",
    "http-errors": "^2.0.0"'

if [[ "$VIEW_ENGINE" == "ejs" ]]; then
  DEPS="$DEPS,
    \"ejs\": \"^3.1.10\""
elif [[ "$VIEW_ENGINE" == "pug" ]]; then
  DEPS="$DEPS,
    \"pug\": \"^3.0.3\""
elif [[ "$VIEW_ENGINE" == "hbs" ]]; then
  DEPS="$DEPS,
    \"hbs\": \"^4.2.0\""
fi

DEV_DEPS='    "typescript": "^5.4.5",
    "@types/node": "^20.14.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/cookie-parser": "^1.4.7",
    "@types/debug": "^4.1.12",
    "@types/http-errors": "^2.0.4",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.3"'

EXTRA_SCRIPTS=""
BUILD_SCRIPT="tsc && node copy-static.js"
DEV_SCRIPT="nodemon"

if [[ "$CSS_ENGINE" == "sass" ]]; then
  DEV_DEPS="$DEV_DEPS,
    \"sass\": \"^1.77.4\",
    \"concurrently\": \"^8.2.2\""
  EXTRA_SCRIPTS=',
    "build:sass": "sass src/public/stylesheets/style.scss src/public/stylesheets/style.css --no-source-map"'
  BUILD_SCRIPT="npm run build:sass && tsc && node copy-static.js"
  DEV_SCRIPT="concurrently \\\"sass src/public/stylesheets/style.scss src/public/stylesheets/style.css --watch --no-source-map\\\" \\\"nodemon\\\""
elif [[ "$CSS_ENGINE" == "less" ]]; then
  DEV_DEPS="$DEV_DEPS,
    \"less\": \"^4.2.0\",
    \"concurrently\": \"^8.2.2\""
  EXTRA_SCRIPTS=',
    "build:less": "lessc src/public/stylesheets/style.less src/public/stylesheets/style.css"'
  BUILD_SCRIPT="npm run build:less && tsc && node copy-static.js"
  DEV_SCRIPT="concurrently \\\"nodemon -e less --watch src/public/stylesheets --exec lessc src/public/stylesheets/style.less src/public/stylesheets/style.css\\\" \\\"nodemon\\\""
fi

cat << EOF > "$ABS_APP_DIR/package.json"
{
  "name": "$APP_NAME",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "$BUILD_SCRIPT",
    "start": "node dist/index.js",
    "dev": "$DEV_SCRIPT"$EXTRA_SCRIPTS
  },
  "dependencies": {
$DEPS
  },
  "devDependencies": {
$DEV_DEPS
  }
}
EOF

# ----------------- tsconfig.json -----------------
cat << 'EOF' > "$ABS_APP_DIR/tsconfig.json"
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
EOF

# ----------------- copy-static.js -----------------
cat << 'EOF' > "$ABS_APP_DIR/copy-static.js"
const fs = require('fs');
const path = require('path');

function copyDir(src, dest) {
  if (!fs.existsSync(src)) return;
  fs.mkdirSync(dest, { recursive: true });
  let entries = fs.readdirSync(src, { withFileTypes: true });

  for (let entry of entries) {
    let srcPath = path.join(src, entry.name);
    let destPath = path.join(dest, entry.name);

    if (entry.isDirectory()) {
      copyDir(srcPath, destPath);
    } else {
      fs.copyFileSync(srcPath, destPath);
    }
  }
}

copyDir('src/public', 'dist/public');
if (fs.existsSync('src/views')) {
  copyDir('src/views', 'dist/views');
}
EOF

# ----------------- .env -----------------
cat << EOF > "$ABS_APP_DIR/.env"
PORT=3000
NODE_ENV=development
EOF

# ----------------- .gitignore -----------------
cat << 'EOF' > "$ABS_APP_DIR/.gitignore"
# Dependency directories
node_modules/
