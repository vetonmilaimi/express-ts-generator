doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    block content
EOF

  cat << 'EOF' > "$ABS_APP_DIR/src/views/index.pug"
extends layout

block content
  div.container
    h1= title + " & TypeScript"
    p.subtitle Welcome to your modern Express application skeleton (rendered with Pug)
    div.status-card
      span.status-dot
      span Server is running successfully
    div.actions
      a.btn(href="/users") Test Users Route
EOF

  cat << 'EOF' > "$ABS_APP_DIR/src/views/error.pug"
extends layout

block content
  div.container
    h1= message
    h2= error.status
    pre(style="text-align: left; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px;") #{error.stack}
EOF

elif [[ "$VIEW_ENGINE" == "hbs" ]]; then
  cat << 'EOF' > "$ABS_APP_DIR/src/views/layout.hbs"
<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    {{{body}}}
  </body>
