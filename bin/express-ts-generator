EOF

  cat << 'EOF' > "$ABS_APP_DIR/src/views/index.hbs"
<div class="container">
  <h1>{{title}} & TypeScript</h1>
  <p class="subtitle">Welcome to your modern Express application skeleton (rendered with Handlebars)</p>
  <div class="status-card">
    <span class="status-dot"></span>
    <span>Server is running successfully</span>
  </div>
  <div class="actions">
    <a href="/users" class="btn">Test Users Route</a>
  </div>
</div>
EOF

  cat << 'EOF' > "$ABS_APP_DIR/src/views/error.hbs"
<div class="container">
  <h1>{{message}}</h1>
  <h2>{{error.status}}</h2>
  <pre style="text-align: left; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px;">{{error.stack}}</pre>
</div>
EOF

else
  # Write index.html for API mode (no-view)
  cat << 'EOF' > "$ABS_APP_DIR/src/public/index.html"
<!DOCTYPE html>
<html>
  <head>
    <title>Express TypeScript API</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="container">
      <h1>Express & TypeScript</h1>
      <p class="subtitle">Welcome to your modern Express application skeleton</p>
      <div class="status-card">
        <span class="status-dot"></span>
        <span>API Server is running successfully</span>
      </div>
      <div class="actions">
        <a href="/users" class="btn">Test Users Route</a>
      </div>
    </div>
  </body>
</html>
EOF
fi

# ----------------- Git Init -----------------
if [ "$GIT_INIT" = true ]; then
  if command -v git >/dev/null 2>&1; then
    echo "Initializing git repository..."
    (
      cd "$ABS_APP_DIR"
      git init
      git add .
      git commit -m "Initial commit from Express TypeScript Generator"
    ) >/dev/null 2>&1 || echo "Warning: Failed to initialize git repository."
  else
    echo "Warning: git command not found. Skipping repository initialization."
  fi
fi

