  echo ""
  echo "   Start the development server:"
  echo "     yarn dev"
  echo ""
  echo "   Build the application:"
  echo "     yarn build"
  echo ""
  echo "   Start the compiled application:"
  echo "     yarn start"
elif [[ "$PACKAGE_MANAGER" == "pnpm" ]]; then
  echo "     pnpm install"
  echo ""
  echo "   Start the development server:"
  echo "     pnpm dev"
  echo ""
  echo "   Build the application:"
  echo "     pnpm build"
  echo ""
  echo "   Start the compiled application:"
  echo "     pnpm start"
elif [[ "$PACKAGE_MANAGER" == "bun" ]]; then
  echo "     bun install"
  echo ""
  echo "   Start the development server:"
  echo "     bun dev"
  echo ""
  echo "   Build the application:"
  echo "     bun build"
  echo ""
