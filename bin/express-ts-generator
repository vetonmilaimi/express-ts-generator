cat << 'EOF' > "$ABS_APP_DIR/nodemon.json"
{
  "watch": ["src"],
  "ext": "ts,json,html,css,ejs,pug,hbs",
  "exec": "ts-node src/bin/index.ts"
}
EOF

# ----------------- src/bin/index.ts -----------------
cat << EOF > "$ABS_APP_DIR/src/bin/index.ts"
#!/usr/bin/env node

/**
 * Module dependencies.
 */
import app from '../app';
import debugLib from 'debug';
import http from 'http';

const debug = debugLib('$APP_NAME:server');

/**
 * Get port from environment and store in Express.
 */
const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */
const server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */
function normalizePort(val: string): number | string | boolean {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error: NodeJS.ErrnoException): void {
  if (error.syscall !== 'listen') {
    throw error;
  }

  const bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening(): void {
  const addr = server.address();
  const bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : addr
      ? 'port ' + addr.port
      : 'unknown address';
  debug('Listening on ' + bind);
}
EOF

# ----------------- src/app.ts Setup -----------------
VIEW_ENGINE_SETUP=""
ERROR_HANDLER_RESPONSE=""

if [[ "$VIEW_ENGINE" != "none" ]]; then
  VIEW_ENGINE_SETUP="app.set('views', path.join(__dirname, 'views'));
app.set('view engine', '$VIEW_ENGINE');"
  ERROR_HANDLER_RESPONSE="res.render('error');"
else
  ERROR_HANDLER_RESPONSE="res.json({
    message: err.message,
    error: req.app.get('env') === 'development' ? err : {}
  });"
fi

cat << EOF > "$ABS_APP_DIR/src/app.ts"
import createError from 'http-errors';
import express, { Request, Response, NextFunction } from 'express';
import path from 'path';
import cookieParser from 'cookie-parser';
import logger from 'morgan';
import cors from 'cors';
import dotenv from 'dotenv';

import indexRouter from './routes/index';
import usersRouter from './routes/users';

// Load environment variables
dotenv.config();

const app = express();

$VIEW_ENGINE_SETUP

app.use(cors());
app.use(logger('dev'));
app.use(express.json());
app.use(express.urlencoded({ extended: false }));
app.use(cookieParser());
app.use(express.static(path.join(__dirname, 'public')));

app.use('/', indexRouter);
app.use('/users', usersRouter);

// catch 404 and forward to error handler
app.use((req: Request, res: Response, next: NextFunction) => {
  next(createError(404));
});

// error handler
app.use((err: any, req: Request, res: Response, next: NextFunction) => {
  // set locals, only providing error in development
  res.locals.message = err.message;
  res.locals.error = req.app.get('env') === 'development' ? err : {};

  // render the error page
  res.status(err.status || 500);
  $ERROR_HANDLER_RESPONSE
});

export default app;
EOF

# ----------------- src/controllers/index.controller.ts -----------------
ROUTE_INDEX_RESPONSE=""
if [[ "$VIEW_ENGINE" != "none" ]]; then
  ROUTE_INDEX_RESPONSE="res.render('index', { title: 'Express' });"
else
  ROUTE_INDEX_RESPONSE="res.json({ message: 'Welcome to the Express TypeScript API!' });"
fi

cat << EOF > "$ABS_APP_DIR/src/controllers/index.controller.ts"
import { Request, Response, NextFunction } from 'express';

/**
 * GET home page.
 */
export const getHome = (req: Request, res: Response, next: NextFunction): void => {
  $ROUTE_INDEX_RESPONSE
};
EOF

# ----------------- src/controllers/users.controller.ts -----------------
cat << 'EOF' > "$ABS_APP_DIR/src/controllers/users.controller.ts"
import { Request, Response, NextFunction } from 'express';

/**
 * GET users listing.
 */
export const getUsers = (req: Request, res: Response, next: NextFunction): void => {
  res.send('respond with a resource');
};
EOF

# ----------------- src/routes/index.ts -----------------
cat << 'EOF' > "$ABS_APP_DIR/src/routes/index.ts"
import express from 'express';
import { getHome } from '../controllers/index.controller';

const router = express.Router();

/* GET home page. */
router.get('/', getHome);

export default router;
EOF

# ----------------- src/routes/users.ts -----------------
